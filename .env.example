# Local development only. Copy this file to .env and never commit .env.
POSTGRES_USER=workbench_user
POSTGRES_PASSWORD=local_only_dev_password
POSTGRES_DB=workbench_db

# Must match the database credentials above.
DATABASE_URL=postgresql+psycopg://workbench_user:local_only_dev_password@localhost:5432/workbench_db

# Local Ollama embedding endpoint/model; no paid API key required.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# API settings
MAX_UPLOAD_MB=15
FRONTEND_ORIGIN=http://localhost:5173
